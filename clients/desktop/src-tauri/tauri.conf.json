{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maw",
  "version": "0.1.0",
  "identifier": "com.kiwh77.maw",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "maw",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "url": "http://127.0.0.1:7420/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
